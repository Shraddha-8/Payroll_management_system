# Base URL the browser uses to reach the API.
# "/api" (default) goes through the Vite dev proxy -> VITE_PROXY_TARGET, so no CORS is needed.
VITE_API_URL=/api
# Where the dev proxy forwards /api requests (your FastAPI server).
VITE_PROXY_TARGET=http://localhost:8000
# If you set VITE_API_URL=http://localhost:8000 directly, the backend must enable CORS for the frontend origin.
